# Fill ONLY verified business facts. Anything empty is hidden, never invented.
NEXT_PUBLIC_SITE_URL=https://calicheplumbing.com
NEXT_PUBLIC_BUSINESS_PHONE=            # LeadSmart number, e.g. (602) 555-0147 is the temporary placeholder
NEXT_PUBLIC_BUSINESS_PHONE_E164=       # e.g. +16025550147
NEXT_PUBLIC_PPC_TRACKING_PHONE=        # optional call-tracking number for /lp/*
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_LICENSE_NUMBER=            # not used for a referral brand; leave empty
NEXT_PUBLIC_OFFICE_ADDRESS=            # only a real staffed office
NEXT_PUBLIC_EMERGENCY_24_7=false       # true only if 24/7 answering is staffed
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
NEXT_PUBLIC_GOOGLE_PROFILE_URL=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_ENV=                       # "staging" makes robots.txt disallow everything
LEAD_WEBHOOK_URL=                      # production refuses leads when no destination is set
LEAD_WEBHOOK_SECRET=                   # HMAC-SHA256 signature in x-signature-sha256
IP_HASH_SALT=
DATABASE_URL=
INDEXNOW_KEY=
